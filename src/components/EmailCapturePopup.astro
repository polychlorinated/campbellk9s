---
---

<aside
  id="email-capture-popup"
  class="fixed bottom-5 right-5 z-[70] hidden w-[min(24rem,calc(100vw-2.5rem))]"
  role="dialog"
  aria-modal="false"
  aria-labelledby="email-capture-title"
  data-email-capture-popup
>
  <div
    class="relative overflow-hidden border border-white/50 bg-brand-bg/60 shadow-[0_24px_60px_-12px_rgba(15,28,46,0.35)] ring-1 ring-brand-primary/10 backdrop-blur-xl backdrop-saturate-150"
  >
    <div
      class="absolute inset-x-0 top-0 h-0.5 bg-brand-accent"
      aria-hidden="true"
    ></div>

    <button
      type="button"
      class="absolute top-3 right-3 flex h-8 w-8 items-center justify-center rounded-full text-brand-primary/60 transition-colors hover:bg-brand-primary/5 hover:text-brand-primary"
      aria-label="Close"
      data-email-capture-close
    >
      <svg
        class="h-4 w-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <div class="px-7 pt-8 pb-7 sm:px-8">
      <p class="caption text-brand-accent">Clearer Dogs Club</p>
      <h2
        id="email-capture-title"
        class="mt-2 font-serif text-xl leading-snug text-brand-primary sm:text-2xl"
      >
        The community is live now!
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-brand-primary/70">
        Live Q&As, personalized video feedback, and a private community of
        dog owners — $29/month.
      </p>
      <a
        href="/clearer-dogs-club/"
        data-club-popup-cta
        class="mt-5 inline-flex w-full items-center justify-center gap-2 bg-brand-accent px-6 py-3 text-xs font-medium uppercase tracking-[0.18em] text-brand-primary transition-all duration-300 hover:bg-brand-primary hover:text-brand-bg"
      >
        Join the Club
        <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</aside>

<script>
  const POPUP_KEY = "ck9-club-popup";
  const popup = document.querySelector<HTMLElement>("[data-email-capture-popup]");
  const closeBtn = popup?.querySelector<HTMLButtonElement>(
    "[data-email-capture-close]"
  );
  const cta = popup?.querySelector<HTMLAnchorElement>("[data-club-popup-cta]");

  const markSeen = () => {
    try {
      sessionStorage.setItem(POPUP_KEY, "1");
    } catch {
      // Private mode / storage blocked — nothing to persist.
    }
  };

  const dismiss = () => {
    markSeen();
    popup?.remove();
  };

  try {
    sessionStorage.removeItem("ck9-email-popup");
  } catch {
    // Storage blocked — nothing to clear.
  }

  closeBtn?.addEventListener("click", dismiss);
  cta?.addEventListener("click", dismiss);

  if (window.location.pathname.startsWith("/clearer-dogs-club")) {
    markSeen();
  } else {
    let seen = false;
    try {
      seen = !!sessionStorage.getItem(POPUP_KEY);
    } catch {
      // Storage blocked — still show the popup.
    }

    if (popup && !seen) {
      popup.classList.remove("hidden");
      requestAnimationFrame(() => {
        popup.classList.add("is-visible");
      });
      window.setTimeout(() => {
        if (!popup.isConnected) return;
        markSeen();
        popup.classList.remove("is-visible");
        window.setTimeout(() => popup.remove(), 500);
      }, 5000);
    }
  }
</script>

<style>
  [data-email-capture-popup] {
    transform: translateY(1rem);
    opacity: 0;
    transition:
      opacity 500ms ease,
      transform 500ms ease;
  }

  [data-email-capture-popup].is-visible {
    transform: translateY(0);
    opacity: 1;
  }
</style>
