---
import SocialIcon from "./SocialIcon.astro";

const year = new Date().getFullYear();

const exploreLinks = [
  { href: "/services/", label: "Services" },
  { href: "/our-team/", label: "Our Team" },
  { href: "/testimonials/", label: "Client Stories" },
  { href: "/reviews/", label: "Reviews" },
  { href: "/faqs/", label: "FAQs" },
  { href: "/dog-training-glossary-definitions/", label: "Glossary" },
  { href: "/blog/", label: "Journal" },
  { href: "/shop/", label: "Shop" },
  { href: "/contact/", label: "Contact" },
];

const legalLinks = [
  { href: "/privacy/", label: "Privacy" },
  { href: "/terms/", label: "Terms" },
];

const serviceAreas = [
  "Boston",
  "Waltham",
  "Foxborough",
  "Providence",
  "Newport",
  "Block Island",
  "Westerly",
  "Mystic"
];
---

<footer class="bg-brand-primary text-brand-bg">
  <div class="mx-auto max-w-7xl px-6 pb-10 pt-24 sm:px-10 lg:px-16">
    <div class="grid gap-x-12 gap-y-16 md:grid-cols-12">
      <div class="md:col-span-5">
        <img
          src="/ck9-blue-logo@2x.webp"
          alt="Campbell K9s"
          class="h-24 w-auto brightness-0 invert"
        />
        <p
          class="mt-8 max-w-sm text-base leading-relaxed text-brand-bg/70"
        >
          Quietly serious dog training, off-leash adventures, and a rewarding lifestyle for dogs and their families.
        </p>

        <div class="mt-10 max-w-sm" data-footer-newsletter>
          <p class="caption text-brand-accent">
            Be the first to hear about our community!
          </p>
          <form
            class="mt-4 flex flex-col gap-3 sm:flex-row"
            data-footer-newsletter-form
            novalidate
          >
            <label for="footer-email-input" class="sr-only">
              Email address
            </label>
            <input
              id="footer-email-input"
              type="email"
              name="email"
              autocomplete="email"
              required
              placeholder="Your email address"
              class="w-full flex-1 border border-brand-bg/25 bg-brand-bg/10 px-4 py-3 text-sm text-brand-bg placeholder:text-brand-bg/40 focus:border-brand-accent focus:outline-none"
              data-footer-newsletter-input
            />
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 bg-brand-accent px-6 py-3 text-xs font-medium uppercase tracking-[0.18em] text-brand-primary transition-all duration-300 hover:bg-brand-bg"
            >
              Notify Me
              <span aria-hidden="true">&rarr;</span>
            </button>
          </form>
          <p
            class="mt-2 hidden text-xs text-red-400"
            role="alert"
            data-footer-newsletter-error
          ></p>
        </div>

        <div class="mt-10 flex items-center gap-3">
          <a
            href="https://www.instagram.com/campbell_k9s"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Campbell K9s on Instagram"
            class="group inline-flex h-11 w-11 items-center justify-center border border-brand-bg/20 transition-colors hover:border-brand-accent hover:text-brand-accent"
          >
            <SocialIcon channel="instagram" />
          </a>
          <a
            href="https://www.tiktok.com/@campbell_k9s"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Campbell K9s on TikTok"
            class="group inline-flex h-11 w-11 items-center justify-center border border-brand-bg/20 transition-colors hover:border-brand-accent hover:text-brand-accent"
          >
            <SocialIcon channel="tiktok" />
          </a>
          <a
            href="https://www.facebook.com/campbellk9s"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Campbell K9s on Facebook"
            class="group inline-flex h-11 w-11 items-center justify-center border border-brand-bg/20 transition-colors hover:border-brand-accent hover:text-brand-accent"
          >
            <SocialIcon channel="facebook" />
          </a>
        </div>
      </div>

      <div class="md:col-span-3">
        <h2 class="caption text-brand-bg/55">Service Area</h2>
        <ul class="mt-5 space-y-2">
          {
            serviceAreas.map((a) => (
              <li class="caption text-brand-bg/85">{a}</li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-2">
        <h2 class="caption text-brand-bg/55">Explore</h2>
        <ul class="mt-5 space-y-3">
          {
            exploreLinks.map((l) => (
              <li>
                <a
                  href={l.href}
                  class="font-serif text-base transition-colors hover:text-brand-accent"
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="md:col-span-2">
        <h2 class="caption text-brand-bg/55">Direct</h2>
        <ul class="mt-5 space-y-3 text-sm">
          <li>
            <a
              href="mailto:k9campbellmatt@gmail.com"
              class="border-b border-brand-bg/20 pb-0.5 transition-colors hover:border-brand-accent hover:text-brand-accent"
            >
              k9campbellmatt@gmail.com
            </a>
          </li>
          <li class="caption text-brand-bg/55">By Appointment</li>
        </ul>
      </div>
    </div>

    <div class="mt-20 hairline bg-brand-bg/15"></div>

    <div
      class="mt-8 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center"
    >
      <p class="caption text-brand-bg/45">
        &copy; {year} Campbell K9s &middot; All Rights Reserved
      </p>
      <ul class="flex items-center gap-8">
        {
          legalLinks.map((l) => (
            <li>
              <a
                href={l.href}
                class="caption text-brand-bg/55 transition-colors hover:text-brand-accent"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<script>
  const wrap = document.querySelector<HTMLElement>("[data-footer-newsletter]");
  const form = wrap?.querySelector<HTMLFormElement>(
    "[data-footer-newsletter-form]"
  );
  const input = wrap?.querySelector<HTMLInputElement>(
    "[data-footer-newsletter-input]"
  );
  const error = wrap?.querySelector<HTMLElement>(
    "[data-footer-newsletter-error]"
  );

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!wrap || !input || !error) return;

    const email = input.value.trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      error.textContent = "Please enter a valid email address.";
      error.classList.remove("hidden");
      input.focus();
      return;
    }
    error.classList.add("hidden");

    try {
      const res = await fetch("/api/newsletter", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ email, source: "website footer" }),
      });
      if (!res.ok) throw new Error("Request failed");
      wrap.innerHTML = `
        <p class="caption text-brand-accent">You&rsquo;re on the list</p>
        <p class="mt-2 font-serif text-lg leading-snug text-brand-bg">
          We&rsquo;ll be in touch when the Clearer Dogs Community opens.
        </p>
      `;
    } catch {
      error.textContent =
        "Something went wrong. Please try again in a moment.";
      error.classList.remove("hidden");
    }
  });
</script>
