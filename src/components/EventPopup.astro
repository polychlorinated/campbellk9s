---
import { getVisitState, markPopupSeen } from "../lib/visit";

const CAL_URL = "https://cal.com/clearer-dogs-group-class-october";
---

<dialog
  id="event-popup"
  aria-labelledby="event-popup-title"
  class="m-auto max-h-[calc(100dvh-2rem)] w-[calc(100%-2rem)] max-w-3xl overflow-y-auto border-0 bg-transparent p-0 outline-none"
>
  <div class="relative border border-brand-line bg-brand-bg">
    <span
      class="pointer-events-none absolute left-4 top-4 z-20 h-5 w-5 border-l-2 border-t-2 border-brand-accent"
      aria-hidden="true"></span>
    <span
      class="pointer-events-none absolute right-4 top-4 z-20 h-5 w-5 border-r-2 border-t-2 border-brand-accent"
      aria-hidden="true"></span>
    <span
      class="pointer-events-none absolute bottom-4 left-4 z-20 h-5 w-5 border-b-2 border-l-2 border-brand-accent"
      aria-hidden="true"></span>
    <span
      class="pointer-events-none absolute bottom-4 right-4 z-20 h-5 w-5 border-b-2 border-r-2 border-brand-accent"
      aria-hidden="true"></span>

    <button
      type="button"
      data-event-close
      aria-label="Close event details"
      class="absolute right-4 top-4 z-30 inline-flex h-9 w-9 items-center justify-center border border-brand-line bg-brand-bg text-brand-primary/70 transition-colors duration-300 hover:bg-brand-primary hover:text-brand-bg"
    >
      <svg
        class="h-4 w-4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <div class="grid sm:grid-cols-[2fr_3fr]">
      <div class="relative min-h-56 sm:min-h-full">
        <img
          src="/clearer-dogs-october-17.webp"
          alt="Clearer Dogs Group Class — Saturday, October 17, 2026"
          class="absolute inset-0 h-full w-full object-cover object-top"
        />
      </div>

      <div class="p-8 sm:p-10 lg:p-12">
        <p class="caption text-brand-accent">
          Saturday &middot; October 17, 2026 &middot; 10:00 AM Eastern
        </p>
        <h2
          id="event-popup-title"
          class="mt-5 text-balance font-serif text-3xl leading-[1.05] sm:text-4xl"
        >
          Clearer Dogs{" "}
          <span class="italic text-brand-accent">Group Class</span>
        </h2>
        <p class="mt-5 text-base leading-relaxed text-brand-primary/75 sm:text-lg">
          One Saturday. A small pack. A clearer dog. Hands-on group training
          with the Campbell K9s team &mdash; calm, clear communication and
          real-world obedience work you take home and keep.
        </p>

        <dl class="mt-8 space-y-4 border-t border-brand-line pt-6">
          <div class="flex items-start gap-4">
            <dt class="caption w-24 shrink-0 pt-1 text-brand-primary/55">When</dt>
            <dd class="text-sm leading-relaxed text-brand-primary/80 sm:text-base">
              Saturday, October 17, 2026<br />10:00 AM Eastern
            </dd>
          </div>
          <div class="flex items-start gap-4">
            <dt class="caption w-24 shrink-0 pt-1 text-brand-primary/55">Where</dt>
            <dd class="text-sm leading-relaxed text-brand-primary/80 sm:text-base">
              Shared with confirmed attendees
            </dd>
          </div>
          <div class="flex items-start gap-4">
            <dt class="caption w-24 shrink-0 pt-1 text-brand-primary/55">Spots</dt>
            <dd class="text-sm leading-relaxed text-brand-primary/80 sm:text-base">
              Limited &mdash; by reservation only
            </dd>
          </div>
        </dl>

        <div class="mt-9">
          <a
            href={CAL_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="group inline-flex items-center gap-3 bg-brand-accent px-8 py-4 text-sm font-medium uppercase tracking-[0.18em] text-brand-primary transition-all duration-300 hover:bg-brand-primary hover:text-brand-bg"
          >
            Reserve Your Spot
            <span
              class="inline-block transition-transform duration-300 group-hover:translate-x-1"
              aria-hidden="true"
            >
              &rarr;
            </span>
          </a>
        </div>
      </div>
    </div>
  </div>
</dialog>

<style>
  :global(#event-popup::backdrop) {
    background: rgba(15, 28, 46, 0.78);
    backdrop-filter: blur(6px);
  }
</style>

<script>
  import { getVisitState, markPopupSeen } from "../lib/visit";

  const dialog = document.getElementById("event-popup") as HTMLDialogElement | null;
  if (dialog) {
    const openPopup = () => {
      if (dialog.open) return;
      if (typeof dialog.showModal === "function") {
        dialog.showModal();
      } else {
        dialog.setAttribute("open", "");
      }
      document.body.style.overflow = "hidden";
      markPopupSeen();
      dialog
        .querySelector<HTMLElement>("[data-event-close]")
        ?.focus();
    };

    const closePopup = () => {
      if (typeof dialog.close === "function") {
        dialog.close();
      } else {
        dialog.removeAttribute("open");
      }
      document.body.style.overflow = "";
    };

    document
      .querySelectorAll<HTMLElement>("[data-event-open]")
      .forEach((trigger) => {
        trigger.addEventListener("click", (event) => {
          event.preventDefault();
          openPopup();
        });
      });

    dialog
      .querySelector("[data-event-close]")
      ?.addEventListener("click", closePopup);

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closePopup();
    });

    dialog.addEventListener("close", () => {
      document.body.style.overflow = "";
    });

    const { count, popupSeen } = getVisitState();
    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    if (count === 1 && !popupSeen && !reducedMotion) {
      window.setTimeout(() => {
        if (!dialog.open) openPopup();
      }, 1500);
    }
  }
</script>
