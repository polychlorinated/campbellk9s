<div
  role="region"
  aria-label="Upcoming events"
  class="relative bg-brand-primary"
>
  <div class="absolute inset-x-0 top-0 h-0.5 bg-brand-accent" aria-hidden="true"></div>
  <div
    class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-10 gap-y-3 px-6 py-4 sm:px-10 lg:px-16"
  >
    <p class="min-w-64 flex-1">
      <span class="caption block text-brand-accent">
        No Events Yet
      </span>
      <span class="mt-1 block font-serif text-lg leading-snug text-brand-bg sm:text-xl">
        Check back here for our next event!
      </span>
    </p>
  </div>
</div>
