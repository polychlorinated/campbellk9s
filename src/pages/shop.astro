---
import Layout from "../layouts/Layout.astro";

const siteUrl = "https://campbellk9s.com";
const printifyUrl = "https://campbell-k9s.printify.me/";

const storeGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Store",
      "@id": `${siteUrl}/shop/#store`,
      name: "Campbell K9s Field Store",
      url: `${siteUrl}/shop/`,
      description:
        "Apparel, gear, and accessories for people who take their dogs seriously. Powered by the Square catalog, with print-on-demand swag available through Printify.",
      image: `${siteUrl}/ck9-blue-logo@2x.webp`,
      currenciesAccepted: "USD",
      paymentAccepted: "Credit Card, Debit Card, Apple Pay, Google Pay",
      parentOrganization: { "@id": `${siteUrl}/#business` },
    },
  ],
};
const serializedStoreGraph = JSON.stringify(storeGraph).replace(/</g, "\\u003c");
---

<Layout
  title="Shop — Campbell K9s Field Store | Boston & Providence"
  description="Campbell K9s gear and goods, checked out securely through Square. Print-on-demand swag, stickers, and the full print catalog are available through Printify."
>
  <script type="application/ld+json" set:html={serializedStoreGraph}></script>

  <!-- Page header -->
  <section class="relative bg-brand-primary text-brand-bg">
    <span
      class="pointer-events-none absolute left-6 top-6 h-4 w-4 border-l border-t border-brand-bg/20 sm:left-10 sm:top-10"
      aria-hidden="true"
    ></span>
    <span
      class="pointer-events-none absolute right-6 top-6 h-4 w-4 border-r border-t border-brand-bg/20 sm:right-10 sm:top-10"
      aria-hidden="true"
    ></span>

    <div
      class="mx-auto max-w-7xl px-6 pb-24 pt-20 sm:px-10 sm:pb-28 sm:pt-24 lg:px-16 lg:pb-32 lg:pt-28"
    >
      <p class="caption text-brand-accent">The Store</p>
      <h1
        class="mt-7 max-w-4xl text-balance font-serif text-[clamp(2.5rem,6vw,6rem)] font-bold leading-[0.96] text-brand-bg"
      >
        Gear for the
        <span class="italic text-brand-accent">field.</span>
      </h1>
      <p class="mt-7 max-w-xl text-base leading-relaxed text-brand-bg/70 sm:text-lg">
        Apparel, gear, and goods for people who take their dogs seriously.
        Every order is checked out securely through Square, right from the
        Campbell K9s catalog.
      </p>
    </div>
  </section>

  <!-- Square storefront -->
  <section
    class="relative bg-brand-bg"
    id="store"
    aria-labelledby="store-heading"
  >
    <div class="mx-auto max-w-7xl px-6 py-20 sm:px-10 sm:py-28 lg:px-16 lg:py-36">
      <div class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-12">
        <div class="lg:col-span-4">
          <p class="caption text-brand-accent">Square Catalog</p>
          <div class="mt-6 hairline max-w-[3rem]"></div>
        </div>
        <div class="lg:col-span-8">
          <h2
            id="store-heading"
            class="max-w-3xl text-balance font-serif text-4xl leading-[1.05] sm:text-5xl lg:text-6xl"
          >
            Built for the trail,{" "}
            <em class="font-serif italic text-brand-accent">
              checked out on Square.
            </em>
          </h2>
          <p class="mt-8 max-w-2xl text-lg leading-relaxed text-brand-primary/75 sm:text-xl">
            The catalog below loads live from our Square store. Shipping,
            receipts, and payment are handled by Square — you stay right here
            until checkout.
          </p>
        </div>
      </div>

      <div class="mt-20">
        <div
          id="shop-grid"
          class="grid gap-x-12 gap-y-16 sm:grid-cols-2 lg:grid-cols-3"
          data-store-grid
        ></div>

        <noscript>
          <div class="border border-brand-line px-10 py-16 text-center">
            <p class="font-serif text-3xl leading-tight">
              The store needs <span class="italic text-brand-accent">JavaScript.</span>
            </p>
            <p class="mx-auto mt-6 max-w-md text-base leading-relaxed text-brand-primary/70">
              Enable JavaScript to browse the Square catalog, or visit our
              print-on-demand swag store on Printify.
            </p>
            <div class="mt-10">
              <a
                href={printifyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-3 bg-brand-primary px-8 py-4 text-sm font-medium uppercase tracking-[0.18em] text-brand-bg transition-all duration-300 hover:bg-brand-accent"
              >
                Printify Store &rarr;
              </a>
            </div>
          </div>
        </noscript>
      </div>
    </div>
  </section>

  <!-- Printify / print-on-demand option -->
  <section
    class="relative bg-brand-bg"
    id="swag"
    aria-labelledby="swag-heading"
  >
    <div class="hairline mx-auto max-w-7xl"></div>
    <div class="mx-auto max-w-7xl px-6 py-20 sm:px-10 sm:py-28 lg:px-16 lg:py-36">
      <div class="grid gap-y-10 lg:grid-cols-12 lg:gap-x-16">
        <div class="lg:col-span-7">
          <p class="caption text-brand-accent">Print-on-Demand</p>
          <h2
            id="swag-heading"
            class="mt-6 max-w-2xl text-balance font-serif text-4xl leading-[1.05] sm:text-5xl"
          >
            Swag, stickers, and the{" "}
            <em class="font-serif italic text-brand-accent">full print catalog.</em>
          </h2>
          <p class="mt-8 max-w-2xl text-lg leading-relaxed text-brand-primary/75 sm:text-xl">
            Hats, hoodies, tees, mugs, and dog-print goods — printed to order
            and shipped through Printify. It's a separate catalog from the
            Square store, with its own checkout, shipping, and returns.
          </p>
          <div class="mt-10 flex flex-wrap items-center gap-6">
            <a
              href={printifyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group inline-flex items-center gap-3 bg-brand-primary px-8 py-4 text-sm font-medium uppercase tracking-[0.18em] text-brand-bg transition-all duration-300 hover:bg-brand-accent"
            >
              <span>Visit the Printify Store</span>
              <span
                class="inline-block transition-transform duration-300 group-hover:translate-x-1"
                aria-hidden="true"
              >
                &rarr;
              </span>
            </a>
            <a
              href="/contact/"
              class="caption text-brand-primary/60 transition-colors hover:text-brand-accent"
            >
              Questions about an order?
            </a>
          </div>
        </div>
        <div class="flex flex-col justify-center lg:col-span-5">
          <div class="border border-brand-line px-10 py-12">
            <p class="caption text-brand-primary/55">In the Printify catalog</p>
            <ul class="mt-6 space-y-4">
              {[
                "Hats, hoodies &amp; tees",
                "Stickers, mugs &amp; totes",
                "Trainer-approved field apparel",
              ].map((item) => (
                <li class="flex items-start gap-3">
                  <span
                    class="mt-1.5 block h-1.5 w-1.5 shrink-0 rounded-full bg-brand-accent"
                    aria-hidden="true"
                  ></span>
                  <p class="text-base text-brand-primary/70" set:html={item} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    const grid = document.querySelector<HTMLElement>("[data-store-grid]");
    if (!grid) throw new Error("Store grid missing");

    const printifyUrl = "https://campbell-k9s.printify.me/";
    const esc = (s: unknown) =>
      String(s ?? "").replace(
        /[&<>"']/g,
        (c) =>
          ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;",
          })[c]!
      );

    const currency = (amount: number, code: string) =>
      new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: code || "USD",
      }).format(amount / 100);

    type Variation = {
      id: string;
      name: string | null;
      price: { amount: number; currency: string };
      sellable: boolean;
    };
    type Product = {
      id: string;
      name: string;
      description: string | null;
      image: string | null;
      variations: Variation[];
    };

    function skeletons(count = 6) {
      grid!.innerHTML = Array.from(
        { length: count },
        () => `
        <div class="animate-pulse">
          <div class="aspect-[4/5] bg-brand-line/60"></div>
          <div class="mt-6 h-6 w-2/3 bg-brand-line/60"></div>
          <div class="mt-4 h-4 w-1/2 bg-brand-line/60"></div>
          <div class="mt-8 h-11 w-32 bg-brand-line/60"></div>
        </div>`
      ).join("");
    }

    function status(message: string, retry = true) {
      grid!.innerHTML = `
        <div class="border border-brand-line px-10 py-16 text-center sm:col-span-2 lg:col-span-3">
          <p class="font-serif text-3xl leading-tight">
            <span class="italic text-brand-accent">${esc(message)}</span>
          </p>
          <p class="mx-auto mt-6 max-w-md text-base leading-relaxed text-brand-primary/70">
            The Square catalog is unavailable right now. Try again in a moment,
            or browse the print-on-demand swag store on Printify.
          </p>
          <div class="mt-10 flex flex-wrap items-center justify-center gap-6">
            ${
              retry
                ? `<button type="button" data-retry class="inline-flex items-center gap-3 bg-brand-primary px-8 py-4 text-sm font-medium uppercase tracking-[0.18em] text-brand-bg transition-all duration-300 hover:bg-brand-accent">Try again &rarr;</button>`
                : ""
            }
            <a href="${printifyUrl}" target="_blank" rel="noopener noreferrer" class="caption text-brand-primary/60 transition-colors hover:text-brand-accent">Printify Store</a>
          </div>
        </div>`;
      grid!.querySelector("[data-retry]")?.addEventListener("click", load);
    }

    function emptyState() {
      grid!.innerHTML = `
        <div class="border border-brand-line px-10 py-16 text-center sm:col-span-2 lg:col-span-3">
          <p class="font-serif text-3xl leading-tight">
            The shelves are being <span class="italic text-brand-accent">stocked.</span>
          </p>
          <p class="mx-auto mt-6 max-w-md text-base leading-relaxed text-brand-primary/70">
            Nothing is in the Square catalog yet. In the meantime, the print
            catalog lives on Printify.
          </p>
          <div class="mt-10">
            <a href="${printifyUrl}" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-brand-primary px-8 py-4 text-sm font-medium uppercase tracking-[0.18em] text-brand-bg transition-all duration-300 hover:bg-brand-accent">
              Printify Store &rarr;
            </a>
          </div>
        </div>`;
    }

    function card(product: Product) {
      const sellable = product.variations.filter((v) => v.sellable);
      const first = product.variations[0];
      const priceLabel = first ? currency(first.price.amount, first.price.currency) : "";
      const image = product.image
        ? `<img src="${esc(product.image)}" alt="${esc(product.name)}" loading="lazy" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />`
        : `<img src="/ck9-blue-logo@2x.webp" alt="${esc(product.name)}" loading="lazy" class="h-full w-full object-contain p-12 opacity-40" />`;
      const variations =
        product.variations.length > 1
          ? `
          <label class="flex-1">
            <span class="sr-only">${esc(product.name)} options</span>
            <select data-variation class="w-full border border-brand-line bg-brand-bg px-4 py-3 font-mono text-xs uppercase tracking-widest text-brand-primary focus:border-brand-accent">
              ${product.variations
                .map(
                  (v) =>
                    `<option value="${esc(v.id)}"${v.sellable ? "" : " disabled"}>${esc(
                      v.name || "Standard"
                    )} — ${currency(v.price.amount, v.price.currency)}${v.sellable ? "" : " (sold out)"}</option>`
                )
                .join("")}
            </select>
          </label>`
          : "";

      return `
        <article class="group flex flex-col border-b border-brand-line pb-10 transition-colors hover:border-brand-accent">
          <div class="relative aspect-[4/5] overflow-hidden bg-brand-line/40">
            ${image}
            <span class="caption absolute bottom-3 right-3 bg-brand-bg/95 px-2.5 py-1.5 text-brand-primary">${esc(priceLabel)}</span>
          </div>
          <h3 class="mt-6 font-serif text-2xl leading-tight text-brand-primary transition-colors group-hover:text-brand-accent sm:text-3xl">${esc(product.name)}</h3>
          ${product.description ? `<p class="mt-3 flex-1 text-base leading-relaxed text-brand-primary/75">${esc(product.description)}</p>` : `<div class="flex-1"></div>`}
          <div class="mt-6 flex items-stretch gap-3">
            ${variations}
            ${
              sellable.length > 0
                ? `<button type="button" data-buy data-variation-id="${esc(sellable[0].id)}" class="inline-flex items-center gap-3 bg-brand-accent px-6 py-3 text-sm font-medium uppercase tracking-[0.18em] text-brand-primary transition-all duration-300 hover:bg-brand-primary hover:text-brand-bg disabled:cursor-not-allowed disabled:opacity-60">Buy &rarr;</button>`
                : `<span class="caption self-center text-brand-primary/50">Sold out</span>`
            }
          </div>
          <p data-buy-error class="mt-3 hidden font-mono text-xs text-brand-accent" role="alert"></p>
        </article>`;
    }

    async function buy(variationId: string, btn: HTMLButtonElement) {
      const original = btn.innerHTML;
      btn.disabled = true;
      btn.textContent = "Opening checkout…";
      const errorEl = btn
        .closest("article")
        ?.querySelector<HTMLElement>("[data-buy-error]");
      if (errorEl) errorEl.classList.add("hidden");
      try {
        const res = await fetch("/api/square/checkout", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ variationId, quantity: 1 }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.url) {
          throw new Error(data.error || "Checkout is unavailable right now");
        }
        window.location.href = data.url;
      } catch (err) {
        btn.disabled = false;
        btn.innerHTML = original;
        if (errorEl) {
          errorEl.textContent =
            err instanceof Error ? err.message : "Checkout is unavailable right now";
          errorEl.classList.remove("hidden");
        }
      }
    }

    function render(items: Product[]) {
      if (!items.length) {
        emptyState();
        return;
      }
      grid!.innerHTML = items.map(card).join("");
      grid!.querySelectorAll<HTMLSelectElement>("[data-variation]").forEach((select) => {
        select.addEventListener("change", () => {
          const btn = select
            .closest("article")
            ?.querySelector<HTMLButtonElement>("[data-buy]");
          if (btn) {
            btn.dataset.variationId = select.value;
            btn.disabled = select.selectedOptions.length === 0;
          }
        });
      });
      grid!.querySelectorAll<HTMLButtonElement>("[data-buy]").forEach((btn) => {
        const select = btn
          .closest("article")
          ?.querySelector<HTMLSelectElement>("[data-variation]");
        if (select) btn.dataset.variationId = select.value;
        btn.addEventListener("click", () => {
          const variationId = btn.dataset.variationId;
          if (variationId) buy(variationId, btn);
        });
      });
    }

    async function load() {
      skeletons();
      try {
        const res = await fetch("/api/square/catalog");
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !Array.isArray(data.items)) {
          throw new Error(data.error || "The Square catalog could not be loaded");
        }
        render(data.items as Product[]);
      } catch {
        status("The store is offline.");
      }
    }

    // Success banner when Square redirects back after a completed checkout.
    const params = new URLSearchParams(window.location.search);
    if (params.has("checkout") && params.get("checkout") === "complete") {
      const banner = document.createElement("div");
      banner.className =
        "border border-brand-accent bg-brand-accent/10 px-6 py-4 text-center font-mono text-xs uppercase tracking-widest text-brand-primary";
      banner.textContent =
        "Thanks — your order went through Square. A receipt is on its way.";
      banner.setAttribute("role", "status");
      document.querySelector("#store .mx-auto")?.prepend(banner);
      history.replaceState(null, "", window.location.pathname);
    }

    load();
  </script>
</Layout>
