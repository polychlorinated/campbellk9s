---
import Layout from "../../layouts/Layout.astro";

const siteUrl = "https://campbellk9s.com";
const paypalClientId =
  "BAAR5KkkPPj_ww0WaN7omC0pOswi3kpyf58KCrrxh5xv5w2nk0oNu2hqJ6tns-9ca6pIgW1HTocksKyx-c";
---

<Layout
  title="Gift a Clearer Dogs Club Membership | Campbell K9's"
  description="Members gift 3-, 6-, or 12-month Clearer Dogs Club memberships at 20% off. Send the gift email now or on a date you choose."
  robots="index, follow"
>
  <!-- Header -->
  <section class="relative bg-brand-primary text-brand-bg">
    <span
      class="pointer-events-none absolute left-6 top-6 h-4 w-4 border-l border-t border-brand-bg/20 sm:left-10 sm:top-10"
      aria-hidden="true"></span>
    <span
      class="pointer-events-none absolute right-6 top-6 h-4 w-4 border-r border-t border-brand-bg/20 sm:right-10 sm:top-10"
      aria-hidden="true"></span>

    <div
      class="mx-auto max-w-7xl px-6 pb-20 pt-20 sm:px-10 sm:pt-24 lg:px-16 lg:pb-24">
      <p class="caption text-brand-accent">Member benefit</p>
      <h1
        class="mt-6 max-w-3xl text-balance font-serif text-[clamp(2.5rem,5.5vw,5.5rem)] font-bold leading-[0.98] text-brand-bg">
        Give the gift of
        <span class="italic text-brand-accent">a clearer dog.</span>
      </h1>
      <p class="mt-7 max-w-xl text-lg leading-relaxed text-brand-bg/75">
        A Clearer Dogs Club membership is a gift that keeps giving — calmer
        walks, clearer communication, and a better life with the dog they
        already have.
      </p>
      <p
        class="mt-6 inline-block border border-brand-accent bg-brand-accent/10 px-5 py-3 text-sm font-medium uppercase tracking-[0.14em] text-brand-accent">
        20% off all gifts for active members
      </p>
    </div>
  </section>

  <!-- Gift form -->
  <section class="relative bg-brand-bg" aria-labelledby="form-heading">
    <div class="mx-auto max-w-7xl px-6 py-16 sm:px-10 sm:py-24 lg:px-16">
      <div class="grid gap-y-12 lg:grid-cols-12 lg:gap-x-16">
        <!-- Form column -->
        <div class="lg:col-span-7">
          <h2 id="form-heading" class="sr-only">Gift membership form</h2>

          <!-- Signed out -->
          <div id="gate-signin" class="hidden">
            <div class="border border-brand-line p-10 text-center">
              <p class="caption text-brand-accent">Members only</p>
              <h3 class="mt-4 font-serif text-3xl leading-tight">
                Sign in to <span class="italic">gift memberships.</span>
              </h3>
              <p class="mx-auto mt-5 max-w-md text-base leading-relaxed text-brand-primary/70">
                Gift purchases are a benefit for active Clearer Dogs Club
                members.
              </p>
              <a
                href="/clearer-dogs-club/login/?next=%2Fclearer-dogs-club%2Fgift%2F"
                class="mt-8 inline-flex items-center gap-3 bg-brand-primary px-8 py-4 text-sm font-medium uppercase tracking-[0.18em] text-brand-bg transition-all duration-300 hover:bg-brand-accent">
                Sign In &rarr;
              </a>
              <p class="mt-6 text-sm leading-relaxed text-brand-primary/60">
                Not a member yet?
                <a
                  href="/clearer-dogs-club/"
                  class="text-brand-accent underline underline-offset-2">Join the club</a
                >
                — then gift at 20% off.
              </p>
            </div>
          </div>

          <!-- Signed in but no active membership -->
          <div id="gate-nonmember" class="hidden">
            <div class="border border-brand-line p-10 text-center">
              <p class="caption text-brand-accent">Active membership required</p>
              <h3 class="mt-4 font-serif text-3xl leading-tight">
                Gifts are for <span class="italic">active members.</span>
              </h3>
              <p class="mx-auto mt-5 max-w-md text-base leading-relaxed text-brand-primary/70">
                You're signed in, but your membership isn't active. Subscribe
                to the club, then come back and gift at 20% off.
              </p>
              <a
                href="/clearer-dogs-club/"
                class="mt-8 inline-flex items-center gap-3 bg-brand-primary px-8 py-4 text-sm font-medium uppercase tracking-[0.18em] text-brand-bg transition-all duration-300 hover:bg-brand-accent">
                Become a Member &rarr;
              </a>
            </div>
          </div>

          <!-- Gift form -->
          <div id="gift-form" class="hidden">
            <fieldset class="space-y-4">
              <legend class="caption text-brand-accent">Choose a gift term</legend>
              <div class="grid gap-4 sm:grid-cols-3">
                <label
                  class="flex cursor-pointer items-center justify-between gap-4 border border-brand-line p-6 transition-colors has-checked:border-brand-accent has-checked:bg-brand-accent/5"
                  for="term-3">
                  <span>
                    <span class="block font-serif text-2xl">3 months</span>
                    <span class="mt-1 block text-sm text-brand-primary/60">
                      $87
                    </span>
                  </span>
                  <input
                    id="term-3"
                    type="radio"
                    name="term"
                    value="3"
                    checked
                    class="h-4 w-4 accent-brand-accent" />
                </label>
                <label
                  class="flex cursor-pointer items-center justify-between gap-4 border border-brand-line p-6 transition-colors has-checked:border-brand-accent has-checked:bg-brand-accent/5"
                  for="term-6">
                  <span>
                    <span class="block font-serif text-2xl">6 months</span>
                    <span class="mt-1 block text-sm text-brand-primary/60">
                      $174
                    </span>
                  </span>
                  <input
                    id="term-6"
                    type="radio"
                    name="term"
                    value="6"
                    class="h-4 w-4 accent-brand-accent" />
                </label>
                <label
                  class="flex cursor-pointer items-center justify-between gap-4 border border-brand-line p-6 transition-colors has-checked:border-brand-accent has-checked:bg-brand-accent/5"
                  for="term-12">
                  <span>
                    <span class="block font-serif text-2xl">12 months</span>
                    <span class="mt-1 block text-sm text-brand-primary/60">
                      $348
                    </span>
                  </span>
                  <input
                    id="term-12"
                    type="radio"
                    name="term"
                    value="12"
                    class="h-4 w-4 accent-brand-accent" />
                </label>
              </div>
            </fieldset>

            <fieldset class="mt-10">
              <legend class="caption text-brand-accent">
                How many gifts?
              </legend>
              <div class="mt-4 flex gap-3">
                {
                  [1, 2, 3, 4].map((count) => (
                    <label
                      class="flex h-12 w-12 cursor-pointer items-center justify-center border text-base font-medium transition-colors has-checked:border-brand-accent has-checked:bg-brand-accent has-checked:text-brand-primary"
                      for={`count-${count}`}>
                      <input
                        id={`count-${count}`}
                        type="radio"
                        name="count"
                        value={count}
                        checked={count === 1}
                        class="sr-only" />
                      {count}
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <fieldset class="mt-10">
              <legend class="caption text-brand-accent">
                Recipient email address
              </legend>
              <div id="recipient-fields" class="mt-4 space-y-4"></div>
            </fieldset>

            <!-- Email timing -->
            <fieldset class="mt-10 space-y-4">
              <legend class="caption text-brand-accent">
                When should we send the gift email?
              </legend>
              <div class="grid gap-4 sm:grid-cols-2">
                <label
                  class="flex cursor-pointer items-center gap-4 border border-brand-line p-5 transition-colors has-checked:border-brand-accent has-checked:bg-brand-accent/5"
                  for="send-now">
                  <input
                    id="send-now"
                    type="radio"
                    name="send-mode"
                    value="now"
                    checked
                    class="h-4 w-4 accent-brand-accent" />
                  <span>
                    <span class="block font-serif text-xl">Send it now</span>
                    <span class="mt-1 block text-sm text-brand-primary/60">
                      Emailed right after purchase
                    </span>
                  </span>
                </label>
                <label
                  class="flex cursor-pointer items-center gap-4 border border-brand-line p-5 transition-colors has-checked:border-brand-accent has-checked:bg-brand-accent/5"
                  for="send-later">
                  <input
                    id="send-later"
                    type="radio"
                    name="send-mode"
                    value="later"
                    class="h-4 w-4 accent-brand-accent" />
                  <span>
                    <span class="block font-serif text-xl">Send on a date</span>
                    <span class="mt-1 block text-sm text-brand-primary/60">
                      Perfect for birthdays and holidays
                    </span>
                  </span>
                </label>
              </div>
              <div id="send-date-block" class="hidden pt-2">
                <label class="block">
                  <span class="mb-2 block text-sm text-brand-primary/70">
                    Send date
                  </span>
                  <input
                    type="date"
                    id="send-date"
                    name="send-date"
                    class="w-full border border-brand-line bg-transparent px-4 py-3 text-base text-brand-primary focus:border-brand-accent focus:outline-none" />
                </label>
              </div>
            </fieldset>

            <!-- Summary -->
            <div class="mt-10 border border-brand-line p-6">
              <div class="flex items-center justify-between text-base text-brand-primary/75">
                <span id="summary-gifts-label">Gifts — 3 months × 1</span>
                <span id="summary-subtotal">$87.00</span>
              </div>
              <div class="mt-3 flex items-center justify-between text-base text-brand-accent">
                <span>20% member discount</span>
                <span id="summary-discount">-$17.40</span>
              </div>
              <div class="mt-4 flex items-baseline justify-between border-t border-brand-line pt-4">
                <span class="font-serif text-xl">Total</span>
                <span id="summary-total" class="font-serif text-2xl">$69.60</span>
              </div>
            </div>

            <p class="mt-6 text-sm leading-relaxed text-brand-primary/60">
              We'll email each recipient their access instructions —
              immediately or on the date you choose. A gift term runs
              consecutively — the recipient can create their account whenever
              they're ready and we'll start the clock from their join date.
            </p>

            <div class="mt-8 border border-brand-line p-6">
              <p class="caption text-brand-accent">Checkout</p>
              <div id="gift-paypal-button" class="mt-5"></div>
            </div>
            <p id="gift-error" class="mt-4 hidden text-sm font-medium text-red-700"></p>
          </div>

          <!-- Success -->
          <div id="gift-success" class="hidden border border-brand-line p-10 text-center">
            <p class="caption text-brand-accent">Order complete</p>
            <h3 class="mt-5 font-serif text-3xl leading-tight">
              The gift is on its way.
            </h3>
            <p id="success-email-note" class="mx-auto mt-5 max-w-md text-base leading-relaxed text-brand-primary/70">
              We'll email your recipient with access instructions now. If
              they don't see it, ask them to check spam.
            </p>

            <div class="mt-8 border border-brand-line p-6 text-left">
              <p class="caption text-brand-accent">Instructions for your recipient</p>
              <p class="mt-3 text-sm leading-relaxed text-brand-primary/60">
                If you'd like to share the gift yourself — in a card, over
                dinner, or whenever the moment is right — here are the same
                instructions we email:
              </p>
              <pre
                id="success-instructions-text"
                class="mt-4 max-h-72 overflow-auto whitespace-pre-wrap bg-brand-bg p-4 font-sans text-sm leading-relaxed text-brand-primary"></pre>
              <button
                type="button"
                id="copy-instructions"
                class="mt-4 inline-flex items-center gap-3 border border-brand-primary/25 px-6 py-3 text-xs font-medium uppercase tracking-[0.18em] text-brand-primary transition-all duration-300 hover:border-brand-accent hover:text-brand-accent">
                Copy Instructions
              </button>
              <span id="copy-confirm" class="ml-3 hidden text-xs font-medium uppercase tracking-[0.14em] text-brand-accent">
                Copied
              </span>
            </div>

            <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
              <a
                href="/clearer-dogs-club/"
                class="inline-flex items-center gap-3 text-sm font-medium uppercase tracking-[0.18em] text-brand-primary/70 transition-colors hover:text-brand-accent">
                Back to the Club
              </a>
            </div>
          </div>
        </div>

        <!-- Aside -->
        <aside class="lg:col-span-5">
          <div class="sticky top-28 space-y-8">
            <div class="border border-brand-line p-8">
              <p class="caption text-brand-accent">What they'll get</p>
              <ul class="mt-6 space-y-4 text-base leading-relaxed text-brand-primary/75">
                <li>&mdash; Live Q&As with Matt</li>
                <li>&mdash; Video submissions with personalized replies</li>
                <li>&mdash; Private Facebook community</li>
                <li>&mdash; Practical training advice, videos, and guidance</li>
              </ul>
            </div>
            <div class="bg-brand-primary p-8 text-brand-bg">
              <p class="caption text-brand-accent">The offer</p>
              <p class="mt-5 font-serif text-2xl leading-snug">
                Active members gift at
                <span class="italic text-brand-accent">20% off</span> — every
                gift, every time.
              </p>
            </div>
            <div class="border border-brand-line p-8">
              <p class="caption text-brand-accent">Good to know</p>
              <p class="mt-5 text-base leading-relaxed text-brand-primary/70">
                Gifts are one-time purchases — when the term ends, the
                recipient can continue at the regular monthly rate.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- PayPal checkout -->
  <script src={`https://www.paypal.com/sdk/js?client-id=${paypalClientId}&currency=USD`}></script>
  <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script is:inline>
    (() => {
      const TERMS = { "3": 87, "6": 174, "12": 348 };
      const state = {
        term: 3,
        count: 1,
        sendMode: "now",
        sendDate: "",
        memberEmail: "",
      };

      const gateSignin = document.getElementById("gate-signin");
      const gateNonmember = document.getElementById("gate-nonmember");
      const fields = document.getElementById("recipient-fields");
      const giftsLabel = document.getElementById("summary-gifts-label");
      const subtotalEl = document.getElementById("summary-subtotal");
      const discountEl = document.getElementById("summary-discount");
      const totalEl = document.getElementById("summary-total");
      const errorEl = document.getElementById("gift-error");
      const formEl = document.getElementById("gift-form");
      const successEl = document.getElementById("gift-success");
      const sendDateBlock = document.getElementById("send-date-block");
      const sendDateInput = document.getElementById("send-date");
      const successEmailNote = document.getElementById("success-email-note");
      const instructionsText = document.getElementById(
        "success-instructions-text"
      );
      const copyInstructions = document.getElementById("copy-instructions");
      const copyConfirm = document.getElementById("copy-confirm");
      const giftPayContainer = document.getElementById("gift-paypal-button");

      const money = (value) =>
        "$" + value.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",");

      function renderRecipientFields() {
        fields.innerHTML = "";
        for (let i = 0; i < state.count; i++) {
          const wrapper = document.createElement("div");
          wrapper.innerHTML =
            '<label class="block"><span class="mb-2 block text-sm text-brand-primary/70">Recipient ' +
            (i + 1) +
            (i === 0 ? " — gift membership" : "") +
            '</span><input type="email" required placeholder="name@example.com" class="w-full border border-brand-line bg-transparent px-4 py-3 text-base text-brand-primary placeholder:text-brand-primary/40 focus:border-brand-accent focus:outline-none" /></label>';
          fields.appendChild(wrapper);
        }
      }

      function readRecipients() {
        return Array.from(fields.querySelectorAll("input")).map((input) =>
          input.value.trim()
        );
      }

      function updateSummary() {
        const base = TERMS[state.term] * state.count;
        const discount = base * 0.2;
        const total = base - discount;

        giftsLabel.textContent =
          "Gifts — " + state.term + " months × " + state.count;
        subtotalEl.textContent = money(base);
        discountEl.textContent = "-" + money(discount);
        totalEl.textContent = money(total);
      }

      function buildInstructions(gifts) {
        const lines = [];
        for (const gift of gifts) {
          lines.push("To: " + gift.recipient_email);
          lines.push(
            "Subject: You've been gifted a Clearer Dogs Club membership!"
          );
          lines.push("");
          lines.push(
            `You've been gifted a ${state.term}-month membership to Clearer Dogs Club by Campbell K9s.`
          );
          lines.push("");
          lines.push("Your gift includes:");
          lines.push("- Live Q&As with Matt");
          lines.push("- Video submissions with personalized replies");
          lines.push("- Access to the private Facebook community");
          lines.push("");
          lines.push("To start your membership, create your account here:");
          if (gift.gift_token) {
            lines.push(
              `https://campbellk9s.com/clearer-dogs-club/login/?gift=${gift.gift_token}`
            );
          } else {
            lines.push(
              "https://campbellk9s.com/clearer-dogs-club/login/ (your access link is in the email we send)"
            );
          }
          lines.push("");
          lines.push(
            `Your ${state.term}-month membership begins the day you create your account.`
          );
          lines.push("");
          lines.push(
            "Clearer communication. Better behavior. A better life with your dog."
          );
          lines.push("");
          lines.push("— — —");
          lines.push("");
        }
        return lines.join("\n").trim();
      }

      function showError(message) {
        errorEl.textContent = message;
        errorEl.classList.remove("hidden");
      }

      function clearError() {
        errorEl.classList.add("hidden");
      }

      function activateGiftForm() {
        formEl.classList.remove("hidden");

        document.querySelectorAll('input[name="term"]').forEach((input) => {
          input.addEventListener("change", () => {
            state.term = Number(input.value);
            clearError();
            updateSummary();
          });
        });

        document.querySelectorAll('input[name="count"]').forEach((input) => {
          input.addEventListener("change", () => {
            state.count = Number(input.value);
            clearError();
            renderRecipientFields();
            updateSummary();
          });
        });

        document.querySelectorAll('input[name="send-mode"]').forEach((input) => {
          input.addEventListener("change", () => {
            state.sendMode = input.value;
            sendDateBlock.classList.toggle("hidden", state.sendMode !== "later");
            clearError();
          });
        });

        sendDateInput.addEventListener("change", () => {
          state.sendDate = sendDateInput.value;
          clearError();
        });

        const tomorrow = new Date(Date.now() + 86400000)
          .toISOString()
          .slice(0, 10);
        sendDateInput.min = tomorrow;

        copyInstructions.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(instructionsText.textContent);
            copyConfirm.classList.remove("hidden");
            setTimeout(() => copyConfirm.classList.add("hidden"), 2500);
          } catch {
            // clipboard unavailable — user can select manually
          }
        });

        renderRecipientFields();
        updateSummary();

        paypal
          .Buttons({
            style: {
              shape: "rect",
              color: "gold",
              layout: "vertical",
              label: "pay",
            },
            createOrder: async () => {
              clearError();
              const recipients = readRecipients();
              const invalid = recipients.some(
                (email) => !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
              );
              if (invalid) {
                throw new Error(
                  "Enter a valid email address for each gift recipient."
                );
              }
              if (state.sendMode === "later" && !state.sendDate) {
                throw new Error("Choose a date to send the gift email.");
              }
              const res = await fetch("/api/paypal/create-gift-order", {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({
                  term: state.term,
                  recipients,
                  email: state.memberEmail,
                }),
              });
              const data = await res.json();
              if (!res.ok) {
                throw new Error(data.error || "Could not create the order.");
              }
              return data.id;
            },
            onApprove: async (data) => {
              const res = await fetch("/api/paypal/capture-gift-order", {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({
                  orderId: data.orderID,
                  term: state.term,
                  recipients: readRecipients(),
                  emailMode: state.sendMode === "later" ? "scheduled" : "immediate",
                  sendOn: state.sendMode === "later" ? state.sendDate : null,
                }),
              });
              const result = await res.json();
              if (!res.ok) {
                showError(result.error || "Payment could not be completed.");
                return;
              }
              const gifts = Array.isArray(result.gifts) ? result.gifts : [];
              instructionsText.textContent = buildInstructions(gifts);
              if (state.sendMode === "later") {
                const when = new Date(state.sendDate + "T09:00:00");
                successEmailNote.textContent =
                  "We'll email your recipient on " +
                  when.toLocaleDateString(undefined, {
                    weekday: "long",
                    year: "numeric",
                    month: "long",
                    day: "numeric",
                  }) +
                  ". If they don't see it, ask them to check spam.";
              }
              formEl.classList.add("hidden");
              successEl.classList.remove("hidden");
              window.scrollTo({ top: 0, behavior: "smooth" });
            },
            onError: (err) => {
              showError(
                err && err.message
                  ? err.message
                  : "Something went wrong with PayPal. Please try again."
              );
            },
          })
          .render(giftPayContainer);
      }

      (async () => {
        const res = await fetch("/api/supabase/config");
        const config = await res.json();
        if (!config.configured) {
          gateSignin.classList.remove("hidden");
          return;
        }
        const client = window.supabase.createClient(config.url, config.anonKey);
        const {
          data: { session },
        } = await client.auth.getSession();
        if (!session) {
          gateSignin.classList.remove("hidden");
          return;
        }
        const { data: member } = await client
          .from("members")
          .select("status")
          .eq("supabase_user_id", session.user.id)
          .maybeSingle();
        if (!member || member.status !== "active") {
          gateNonmember.classList.remove("hidden");
          return;
        }
        state.memberEmail = session.user.email || "";
        activateGiftForm();
      })();
    })();
  </script>
</Layout>
