---
import { mkdirSync, writeFileSync } from "node:fs";
import path from "node:path";
import Layout from "../../layouts/Layout.astro";
import {
  getPosts,
  featuredImage,
  featuredImageAlt,
  postCategories,
  formatDate,
  plainText,
} from "../../lib/wordpress";
import type { WPPost } from "../../lib/wordpress";

export async function getStaticPaths() {
  const posts = await getPosts(100);

  const datedPosts = posts
    .filter((post) => post.slug && post.content?.rendered?.trim().length > 0)
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));

  const dateMap: Record<string, string> = {};
  for (const { params, props } of datedPosts) {
    dateMap[params.slug] = props.post.modified || props.post.date;
  }
  try {
    mkdirSync(path.resolve(process.cwd(), ".astro"), { recursive: true });
    writeFileSync(
      path.resolve(process.cwd(), ".astro", "blog-lastmod.json"),
      JSON.stringify(dateMap)
    );
  } catch (error) {
    console.warn("[blog] Could not persist lastmod map for sitemap", error);
  }

  return datedPosts;
}

const { post } = Astro.props as { post: WPPost };

const siteUrl = "https://campbellk9s.com";
const slug = post.slug;
const canonical = `${siteUrl}/blog/${slug}/`;
const postTitle = plainText(post.title.rendered);
const postDescription =
  plainText(post.excerpt.rendered) ||
  "A training field note from Campbell K9's Journal.";
const postImage = featuredImage(post);
const postDate = post.date;
const postModified = post.modified || post.date;
const category = postCategories(post)[0]?.name ?? "Field Notes";

const articleGraph = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "@id": `${canonical}#article`,
      headline: postTitle,
      description: postDescription,
      image: postImage ? [postImage] : undefined,
      datePublished: postDate,
      dateModified: postModified,
      author: [
        {
          "@type": "Person",
          name: "Matt Campbell",
          url: `${siteUrl}/our-team/#matt-campbell`,
        },
      ],
      publisher: { "@id": `${siteUrl}/#business` },
      mainEntityOfPage: canonical,
      inLanguage: "en-US",
    },
  ],
};
const serializedArticle = JSON.stringify(articleGraph).replace(/</g, "\\u003c");
---

<Layout
  title={`${postTitle} — Campbell K9's Journal`}
  description={postDescription}
  ogImage={postImage ?? undefined}
>
  <script type="application/ld+json" set:html={serializedArticle}></script>

  <article>
    <header class="bg-brand-primary text-brand-bg">
      <div
        class="mx-auto max-w-7xl px-6 pb-20 pt-12 sm:px-10 sm:pb-28 sm:pt-16 lg:px-16"
      >
        <a
          href="/blog/"
          class="caption inline-flex items-center gap-2 text-brand-bg/55 transition-colors hover:text-brand-accent"
        >
          <span aria-hidden="true">&larr;</span> The Journal
        </a>

        <div class="mt-16 grid gap-8 lg:grid-cols-12 lg:gap-12">
          <div class="lg:col-span-3">
            <p class="caption text-brand-accent">Field Note</p>
            <div class="mt-5 h-px w-10 bg-brand-bg/20"></div>
            <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 lg:block">
              <p class="caption text-brand-bg/55">{formatDate(postDate)}</p>
              <p class="caption mt-0 text-brand-bg/55 lg:mt-2">{category}</p>
            </div>
          </div>
          <div class="lg:col-span-9">
            <h1
              class="max-w-5xl text-balance font-serif text-[clamp(2.5rem,6vw,5.75rem)] leading-[0.98] text-brand-bg"
            >
              {postTitle}
            </h1>
          </div>
        </div>
      </div>
    </header>

    {postImage && (
      <div class="mx-auto max-w-7xl px-6 pt-10 sm:px-10 sm:pt-14 lg:px-16">
        <div class="aspect-[16/9] overflow-hidden bg-brand-line">
          <img
            src={postImage}
            alt={featuredImageAlt(post)}
            class="h-full w-full object-cover"
            fetchpriority="high"
          />
        </div>
      </div>
    )}

    <div
      class="mx-auto grid max-w-7xl gap-12 px-6 py-16 sm:px-10 sm:py-24 lg:grid-cols-12 lg:px-16 lg:py-28"
    >
      <aside class="hidden lg:col-span-3 lg:block" aria-label="Article details">
        <div class="sticky top-28 border-t border-brand-line pt-5">
          <p class="caption text-brand-muted">Campbell K9's Journal</p>
          <p
            class="mt-4 max-w-[14rem] font-serif text-lg italic leading-relaxed text-brand-primary/70"
          >
            Training observations and lessons from life with the pack.
          </p>
        </div>
      </aside>

      <div class="article-prose lg:col-span-7" set:html={post.content.rendered} />
    </div>

    <footer class="mx-auto max-w-7xl px-6 pb-20 sm:px-10 sm:pb-28 lg:px-16">
      <div class="border-t border-brand-line pt-8">
        <a
          href="/blog/"
          class="caption inline-flex items-center gap-2 text-brand-muted transition-colors hover:text-brand-accent"
        >
          <span aria-hidden="true">&larr;</span> Back to Journal
        </a>
      </div>
    </footer>
  </article>
</Layout>
